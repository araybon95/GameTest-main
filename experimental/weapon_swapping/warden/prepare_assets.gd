extends SceneTree
## Reproducible experimental asset assembly; original artwork is never overwritten.
const ROOT = "res://experimental/weapon_swapping/warden/assets/"
const Builds = preload("res://scripts/party_builds.gd")
# Windup repair includes the old mace pommel below-left of the raised gauntlet.
const POLYGONS = [
 [Vector2(167,306),Vector2(222,308),Vector2(356,350),Vector2(356,459),Vector2(250,459),Vector2(168,361)],
 [Vector2(835,306),Vector2(895,306),Vector2(1056,350),Vector2(1056,483),Vector2(955,483),Vector2(835,363)],
 [Vector2(1142,70),Vector2(1202,0),Vector2(1318,0),Vector2(1318,82),Vector2(1205,147),Vector2(1160,147),Vector2(1122,170),Vector2(1098,163),Vector2(1098,138),Vector2(1142,110)],
 [Vector2(136,758),Vector2(185,758),Vector2(324,819),Vector2(324,932),Vector2(205,932),Vector2(136,820)],
 [Vector2(601,798),Vector2(650,798),Vector2(783,863),Vector2(783,990),Vector2(658,990),Vector2(601,864)],
 [Vector2(1150,898),Vector2(1367,898),Vector2(1367,1024),Vector2(1150,1024)]
]
const GRIPS = [Vector2(190,325),Vector2(869,331),Vector2(1178,103),Vector2(161,785),Vector2(628,833),Vector2(1333,945)]
const ANGLES = [34.0,30.0,-51.0,34.0,30.0,15.0]
const STATES = ["idle","attack","windup","guard","hurt","death"]
func _initialize() -> void: call_deferred("run")
func transformed(source: Image, pivot: Vector2, grip: Vector2, angle: float, scale_factor: float, canvas: Vector2i) -> Image:
 var result := Image.create(canvas.x,canvas.y,false,Image.FORMAT_RGBA8)
 result.fill(Color.TRANSPARENT)
 var transform := Transform2D(deg_to_rad(angle)+PI/2,Vector2.ONE*scale_factor,0,grip)
 var inverse: Transform2D = transform.affine_inverse()
 for y in range(canvas.y):
  for x in range(canvas.x):
   var point: Vector2 = inverse*Vector2(x+0.5,y+0.5)+pivot
   var sx: int = int(floor(point.x))
   var sy: int = int(floor(point.y))
   if sx >= 0 and sy >= 0 and sx < source.get_width() and sy < source.get_height(): result.set_pixel(x,y,source.get_pixel(sx,sy))
 return result
func run() -> void:
 var original: Image = load("res://assets/art_library/party_builds/warden.png").get_image()
 var cleaned: Image = Image.load_from_file(ROOT+"clean-body-source.png")
 assert(original.get_size() == cleaned.get_size())
 var source: Image = Image.load_from_file(ROOT+"sword-source.png")
 var swords: Array[Image] = [source.get_region(Rect2i(335,10,300,1000)),source.get_region(Rect2i(900,10,305,1000))]
 var pivots := [Vector2(149,825),Vector2(151,825)]
 var ids := ["warden_sword","warden_legend"]
 var records: Dictionary = {}
 var canvas := Vector2i(768,700)
 var foot := Vector2(350,650)
 for index in range(6):
  var region: Rect2i = Rect2i(Builds.REGIONS.warden[index])
  var body: Image = original.get_region(region)
  var polygon := PackedVector2Array(POLYGONS[index])
  for y in range(region.size.y):
   for x in range(region.size.x):
    var absolute: Vector2 = Vector2(region.position+Vector2i(x,y))
    if Geometry2D.is_point_in_polygon(absolute,polygon): body.set_pixel(x,y,cleaned.get_pixelv(Vector2i(absolute)))
  var body_path: String = ROOT+STATES[index]+"-body.png"
  assert(body.save_png(body_path) == OK)
  var anchor: float = float(Builds.ANCHORS.warden[index])-region.position.x
  var offset := Vector2i(foot-Vector2(anchor,region.size.y))
  var grip: Vector2 = GRIPS[index]-Vector2(region.position)+Vector2(offset)
  var hand_area := Rect2i(Vector2i(GRIPS[index])-region.position-Vector2i(25,22),Vector2i(50,44))
  var hands: Image = body.get_region(hand_area)
  var hands_path: String = ROOT+STATES[index]+"-hands.png"
  assert(hands.save_png(hands_path) == OK)
  for weapon_index in range(2):
   var weapon_id: String = ids[weapon_index]
   var weapon: Image = transformed(swords[weapon_index],pivots[weapon_index],grip,ANGLES[index],0.28,canvas)
   var path: String = ROOT+STATES[index]+"-"+weapon_id+".png"
   assert(weapon.save_png(path) == OK)
   var pose: String = STATES[index]
   records["warden|original|"+weapon_id+"|"+pose] = {"hero":"warden","style":"original","weapon_profile":weapon_id,"pose":pose,"canvas_size":canvas,"foot":foot,"grips":[grip],"weapon_axis":PackedVector2Array([grip,grip+Vector2.RIGHT.rotated(deg_to_rad(ANGLES[index]))*230]),"metadata":{"pose_id":"warden","party_build":"warden","appearance_style":"warden_complete","warden_outfit":"original","idle_pixel_height":700.0,"body_height_pixels":479.0,"hit_point":foot+Vector2(0,-297),"emitter_point":grip,"experimental_weapon":true},"layers":[{"path":body_path,"offset":offset,"role":"body"},{"path":path,"offset":Vector2i.ZERO,"role":"front_weapon"},{"path":hands_path,"offset":offset+hand_area.position,"role":"hands"}]}
 var output := FileAccess.open("res://experimental/weapon_swapping/warden/frames.gd",FileAccess.WRITE)
 output.store_string("extends RefCounted\n## Generated by prepare_assets.gd; experimental records only.\nstatic var RECORDS: Dictionary = str_to_var(\"\"\""+var_to_str(records)+"\"\"\")\n")
 print("PASS: prepared six registered body/hand poses with two independently composed swords; original pixels outside repair masks preserved")
 quit()
