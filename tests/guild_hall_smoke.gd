extends SceneTree
const State = preload("res://scripts/game_data.gd")
const Profile = preload("res://scripts/guild_hall_profile.gd")
const Hall = preload("res://scenes/hub/guild_hall.gd")
func _initialize() -> void: call_deferred("run")
func snapshot() -> Dictionary:
	return {"party":State.party.duplicate(),"gold":State.gold,"inventory":State.inventory.duplicate(true),"equipment":State.equipment.duplicate(true),"expedition":State.selected_expedition.duplicate(true),"floors":State.floors.duplicate(true),"rng":State.loot_rng.state,"progress":State.hero_progress.duplicate(true)}
func settle() -> void:
	for i in range(3): await process_frame
func run() -> void:
	State.progress_loaded = true
	State.party.assign(["warden","ranger","occultist"])
	State.select_expedition("old_road")
	State.start_run(42)
	var before := snapshot()
	var path: String = "user://guild_hall_test.cfg"
	if FileAccess.file_exists(path): DirAccess.remove_absolute(path)
	assert(Profile.read_profile(path) == Profile.DEFAULTS)
	var sanitized := Profile.clean({"name":" \n ","banner":"unknown","emblem":99,"furnishing":[],"pinned_expedition":"missing"})
	assert(sanitized == Profile.DEFAULTS,"Malformed cosmetic values fall back")
	assert(Profile.clean({"name":"A\nB\tC"}).name == "A B C")
	assert(str(Profile.clean({"name":"x".repeat(50)}).name).length() == 32)
	var hall := Hall.new()
	hall.profile_path = path
	root.add_child(hall)
	hall.set_process(false)
	await settle()
	assert(hall.get_node("ExpeditionBoard") is Button)
	assert(hall.get_node("OnlineGathering").disabled,"No fake online session")
	assert(hall.backdrop.texture != null and hall.banner.fabric != null and hall.prop.texture is AtlasTexture,"Live generated layers loaded")
	for id in State.party:
		var hero: TextureRect = hall.get_node("GuildHero_"+id)
		assert(hero.texture != null and is_equal_approx(hero.size.y,295) and hero.position.y+hero.size.y < 956,"Heroes fit the gathering floor: %s size %s at %s" % [id,hero.size,hero.position])
	hall.get_node("CustomizeHall").pressed.emit()
	var field: LineEdit = hall.modal.get_node("GuildNameEdit")
	field.text_submitted.emit("Lanternbound")
	hall.modal.get_node("Choice_banner").item_selected.emit(2)
	hall.modal.get_node("Choice_emblem").item_selected.emit(1)
	hall.modal.get_node("Choice_lighting").item_selected.emit(2)
	hall.modal.get_node("Choice_furnishing").item_selected.emit(1)
	var saved := Profile.read_profile(path)
	assert(saved.name == "Lanternbound" and saved.banner == "slate" and saved.emblem == "blades" and saved.lighting == "candlelit" and saved.furnishing == "armory")
	var original_bytes: String = FileAccess.get_file_as_string(path)
	assert(DirAccess.make_dir_absolute(path+".tmp") == OK)
	assert(Profile.write_profile(Profile.DEFAULTS,path) != OK,"A blocked staging file must fail safely")
	assert(FileAccess.get_file_as_string(path) == original_bytes,"Failed writes preserve the prior profile")
	DirAccess.remove_absolute(path+".tmp")
	hall.close_modal()
	await settle()
	hall.open_board()
	var pin := hall.modal.find_child("Pin_path_beast",true,false)
	assert(pin != null and not pin.disabled,"Released routes appear on the board")
	pin.pressed.emit()
	assert(hall.profile.pinned_expedition == "path_beast" and Profile.read_profile(path).pinned_expedition == "path_beast")
	assert(hall.modal.find_child("Pin_tangled_weald",true,false).disabled,"Locked notices cannot be pinned")
	assert(hall.modal.find_child("Pin_village_chapel",true,false) == null,"Unreleased expeditions are not offered")
	hall.close_modal()
	await settle()
	var settings = root.get_node("GameSettings")
	settings.ambient_motion = false
	hall._process(2)
	assert(hall.clock == 0,"Reduced motion stops decorative motion")
	settings.ambient_motion = true
	hall._process(2)
	assert(hall.clock == 2)
	hall.open_board()
	hall._process(2)
	assert(hall.clock == 2,"Modal board pauses decorative motion")
	assert(snapshot() == before,"Hall customization/route pins do not mutate gameplay or RNG")
	hall.free()
	await settle()
	var original_party: Array[String] = State.party.duplicate()
	State.party.assign(["healer","crusader","warden"])
	var reopened := Hall.new()
	reopened.profile_path = path
	root.add_child(reopened)
	reopened.set_process(false)
	assert(reopened.profile.name == "Lanternbound" and reopened.profile.pinned_expedition == "path_beast")
	for id in State.party:
		var hero: TextureRect = reopened.get_node("GuildHero_"+id)
		assert(is_equal_approx(hero.size.y,295) and hero.modulate == reopened.backdrop.modulate,"All five heroes fit and share room lighting")
	reopened.free()
	State.party.assign(original_party)
	var unsupported := ConfigFile.new()
	unsupported.set_value("hall","version",2)
	unsupported.set_value("hall","profile",{"name":"Future guild"})
	assert(unsupported.save(path) == OK)
	assert(Profile.write_profile(Profile.DEFAULTS,path) == ERR_FILE_UNRECOGNIZED)
	assert(unsupported.load(path) == OK and unsupported.get_value("hall","version") == 2,"Future save was preserved")
	DirAccess.remove_absolute(path)
	var corrupt := FileAccess.open(path,FileAccess.WRITE)
	corrupt.store_string("[broken")
	corrupt.close()
	print("EXPECTED: the following two ConfigFile errors reject a deliberately corrupted test profile.")
	assert(Profile.read_profile(path) == Profile.DEFAULTS)
	assert(Profile.write_profile(Profile.DEFAULTS,path) != OK,"Unreadable save must not be overwritten")
	assert(FileAccess.get_file_as_string(path) == "[broken")
	DirAccess.remove_absolute(path)
	change_scene_to_file("res://scenes/hub/settlement.tscn")
	await settle()
	assert(current_scene.has_node("GuildHallEntrance"))
	assert(not current_scene.get_node("GuildHallEntrance").get_global_rect().intersects(current_scene.get_node("Header").get_global_rect()),"Guild entrance must not cover the settlement heading")
	current_scene.get_node("GuildHallEntrance").pressed.emit()
	await settle()
	assert(current_scene.scene_file_path == "res://scenes/hub/guild_hall.tscn")
	current_scene.get_node("GuildHallReturn").pressed.emit()
	await settle()
	assert(current_scene.scene_file_path == "res://scenes/hub/settlement.tscn")
	preload("res://scripts/settlement_music.gd").stop()
	var music = preload("res://scripts/settlement_music.gd").player()
	if music != null: music.stream = null; music.queue_free()
	await create_timer(0.1).timeout
	print("PASS: guild hall cosmetic roundtrip/sanitization/version protection, real UI controls, route board, reduced motion, unchanged gameplay/RNG and settlement navigation")
	quit()
